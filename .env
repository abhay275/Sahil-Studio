# ============================================================
# Cloudinary Configuration for Sahil Studio
# ============================================================
# 1. Cloud Name:
#    Found on your Cloudinary Dashboard (https://console.cloudinary.com/console)
#    under "Product Environment Credentials" -> "Cloud name".
VITE_CLOUDINARY_CLOUD_NAME=derowd0h

# 2. Upload Preset (Unsigned):
#    Go to Settings -> Upload -> Upload Presets in Cloudinary Console.
#    Click "Add upload preset", set Signing Mode to "Unsigned",
#    save it, and copy the preset name here.
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Note: In client-side Vite applications, only variables prefixed with VITE_
# are exposed to the browser. Never put your API Secret in this file!
